# -- Limit Switch Enable --
record(bo, "$(P)$(M):LimitEn") {
    field(DESC, "Limit switch enable")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))ZYNQ_LIMIT_EN")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
    field(PINI, "YES")
}

record(bi, "$(P)$(M):LimitEn_RBV") {
    field(DESC, "Limit switch enable readback")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))ZYNQ_LIMIT_EN")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
    field(SCAN, "I/O Intr")
}

# -- Limit Switch Polarity --
record(bo, "$(P)$(M):LimitPol") {
    field(DESC, "Limit switch polarity")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))ZYNQ_LIMIT_POL")
    field(ZNAM, "Normal")
    field(ONAM, "Inverted")
    field(PINI, "YES")
}

record(bi, "$(P)$(M):LimitPol_RBV") {
    field(DESC, "Limit switch polarity readback")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))ZYNQ_LIMIT_POL")
    field(ZNAM, "Normal")
    field(ONAM, "Inverted")
    field(SCAN, "I/O Intr")
}

# -- Microstep Mode --
record(mbbo, "$(P)$(M):UstepMode") {
    field(DESC, "Microstep mode")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))ZYNQ_USTEP_MODE")
    field(ZRST, "Full step 100%")
    field(ZRVL, "0")
    field(ONST, "1/2 step")
    field(ONVL, "1")
    field(TWST, "1/4 step")
    field(TWVL, "2")
    field(THST, "1/8 step")
    field(THVL, "3")
    field(FRST, "1/16 step")
    field(FRVL, "4")
    field(FVST, "1/32 step")
    field(FVVL, "5")
    field(SXST, "1/128 step")
    field(SXVL, "7")
    field(SVST, "1/256 step")
    field(SVVL, "8")
    field(EIST, "NC 1/2 step")
    field(EIVL, "17")
    field(PINI, "YES")
}

record(mbbi, "$(P)$(M):UstepMode_RBV") {
    field(DESC, "Microstep mode readback")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))ZYNQ_USTEP_MODE")
    field(ZRST, "Full step 100%")
    field(ZRVL, "0")
    field(ONST, "1/2 step")
    field(ONVL, "1")
    field(TWST, "1/4 step")
    field(TWVL, "2")
    field(THST, "1/8 step")
    field(THVL, "3")
    field(FRST, "1/16 step")
    field(FRVL, "4")
    field(FVST, "1/32 step")
    field(FVVL, "5")
    field(SXST, "1/128 step")
    field(SXVL, "7")
    field(SVST, "1/256 step")
    field(SVVL, "8")
    field(EIST, "NC 1/2 step")
    field(EIVL, "17")
    field(UNSV, "INVALID")
    field(SCAN, "I/O Intr")
}

# -- Sleep Mode --
record(bo, "$(P)$(M):Sleep") {
    field(DESC, "Sleep mode")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))ZYNQ_SLEEP")
    field(ZNAM, "Awake")
    field(ONAM, "Sleep")
}

record(bi, "$(P)$(M):Sleep_RBV") {
    field(DESC, "Sleep mode readback")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))ZYNQ_SLEEP")
    field(ZNAM, "Awake")
    field(ONAM, "Sleep")
    field(SCAN, "I/O Intr")
}

# -- Reset --
record(bo, "$(P)$(M):Reset") {
    field(DESC, "Reset driver")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))ZYNQ_RESET")
    field(ZNAM, "Idle")
    field(ONAM, "Reset")
    field(HIGH, "0.01")
}

# -- Step Rate Readback --
record(longin, "$(P)$(M):StepRate_RBV") {
    field(DESC, "Raw step rate readback")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))ZYNQ_STEP_RATE")
    field(SCAN, "I/O Intr")
}

# -- Motor Resolution --
# FullStepsPerRev is the physical full-step count, independent of microstepping.
# SREV counts commanded microsteps per revolution. The motor record calculates
# MRES = UREV / SREV when SREV changes, preserving UREV and EGU velocities.
record(longout, "$(P)$(M):FullStepsPerRev") {
    field(DESC, "Full steps per revolution")
    field(VAL,  "$(FULL_STEPS_PER_REV=200)")
    field(DRVL, "1")
    # Keep SREV within a signed 32-bit integer at the maximum 1/256 mode.
    field(DRVH, "8388607")
    field(PINI, "YES")
}

record(calcout, "$(P)$(M):CalcSREV") {
    field(DESC, "Calculate microsteps per revolution")
    field(INPA, "$(P)$(M):FullStepsPerRev CP MS")
    # RVAL is the hardware mode code; VAL is the mbbi state index.
    field(INPB, "$(P)$(M):UstepMode_RBV.RVAL CP MS")
    field(CALC, "A*2^(FLOOR(B)&15)")
    field(OUT,  "$(P)$(M).SREV PP")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(IVOA, "Don't drive outputs")
}
