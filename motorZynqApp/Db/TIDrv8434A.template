# Microstepping mode for TI motor driver
# DRV8434A.
#
# Macros:
#   P     - PV prefix (e.g., "ZYNQ:")
#   M     - Motor name (e.g., "m1")
#   PORT  - Asyn port name
#   ADDR  - Axis number (0-3)


record(mbbo, "$(P)$(M):UstepMode") {
    field(DESC, "Microstep mode")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))ZYNQ_USTEP_MODE")
    field(ZRST, "Full step 100%")
    field(ZRVL, "0")
    field(ONST, "1/2 step, non-circular")
    field(ONVL, "1")
    field(TWST, "1/2 step")
    field(TWVL, "2")
    field(THST, "1/4 step")
    field(THVL, "3")
    field(FRST, "1/8 step")
    field(FRVL, "4")
    field(FVST, "1/16 step")
    field(FVVL, "5")
    field(SXST, "1/32 step")
    field(SXVL, "6")
    field(SVST, "1/128 step")
    field(SVVL, "7")
    field(EIST, "1/256 step")
    field(EIVL, "8")
    field(PINI, "YES")
}

record(mbbi, "$(P)$(M):UstepMode_RBV") {
    field(DESC, "Microstep mode readback")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR))ZYNQ_USTEP_MODE")
    field(ZRST, "Full step 100%")
    field(ZRVL, "0")
    field(ONST, "1/2 step, non-circular")
    field(ONVL, "1")
    field(TWST, "1/2 step")
    field(TWVL, "2")
    field(THST, "1/4 step")
    field(THVL, "3")
    field(FRST, "1/8 step")
    field(FRVL, "4")
    field(FVST, "1/16 step")
    field(FVVL, "5")
    field(SXST, "1/32 step")
    field(SXVL, "6")
    field(SVST, "1/128 step")
    field(SVVL, "7")
    field(EIST, "1/256 step")
    field(EIVL, "8")
    field(UNSV, "INVALID")
    field(SCAN, "I/O Intr")
}

# Value 1 and 2 are both 1/2 step.  Value 6 is 1/32; the next supported
# mode is 1/128, so there is no 1/64 entry.
record(calcout, "$(P)$(M):CalcSREV") {
    field(DESC, "Calculate microsteps per revolution")
    field(INPA, "$(P)$(M):FullStepsPerRev CP MS")
    field(INPB, "$(P)$(M):UstepMode_RBV.RVAL CP MS")
    field(CALC, "A*2^(FLOOR(B)-(FLOOR(B)>1)+(FLOOR(B)>6))")
    field(OUT,  "$(P)$(M).SREV PP")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(IVOA, "Don't drive outputs")
}
